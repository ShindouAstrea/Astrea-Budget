# Plantilla de variables de entorno. Copia este archivo a .env y completa
# los valores de tu proyecto Supabase (Dashboard → Project Settings → API).
#
#   cp .env.example .env
#
# La llave pública es pública por diseño (la protección real es la RLS).
# Supabase la renombró de "anon key" a "publishable key": sirven las dos
# variables, se usa SUPABASE_PUBLISHABLE_KEY si está y si no la anon.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
