<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas de backup para Android 11 e inferiores (android:fullBackupContent).
  Excluimos los SharedPreferences: ahí viven la sesión de Supabase
  (supabase.auth.token) y la caché offline (claves cache:*). Restaurarlos al
  reinstalar dejaba al usuario "dentro" de una sesión que ya no existía.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
