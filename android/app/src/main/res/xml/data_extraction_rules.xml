<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas para Android 12+ (android:dataExtractionRules). `allowBackup="false"`
  ya corta el respaldo en la nube, pero la transferencia dispositivo a
  dispositivo se rige por este archivo: sin él, la sesión de Supabase y la
  caché viajarían igual al teléfono nuevo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
